<section class="section box">
    <h1 class="title">Gallery</h1>
    <div class="columns">
        <div class="column fixed-grid has-3-cols is-full" style="max-height:500px; overflow-y:auto">
            <div class="grid">
                {{#each poi.images}}
                <div class="cell" style=
                "display:flex; flex-direction:column;
                 align-items:center;
                  border:1px solid grey;
                   border-radius: 3px;
                    padding:5px;">
                    <a href="{{this.imageUrl}}" target="blank">
                        <img src="{{this.imageUrl}}" style="min-height:300px; max-height:150px; object-fit: cover">
                    </a>
                </div>

                {{/each}}
                
            </div>
        </div>
</section>