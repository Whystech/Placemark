{{> menu}}

<section class="section">
  <div class="box columns">
    <div class="column is-half">
      <h1 class="title">{{poi.name}}</h1>
      <h2 class="subtitle has-text-grey-3">Summary: {{poi.summary}}</h2>

      <div class="buttons column is-full">
        <a href="/dashboard" class="button is-link">Back to Dashboard</a>
      </div>
    </div>
    <div class=" column is-half">
      <div id="map" style="height:300px"></div>
      <p>Latitude: {{poi.latitude}}</p>
      <p>Longitude: {{poi.longitude}}</p>
    </div>
</section>
{{#if poi.description}}
<section class="section">
  <div class="box content">
    <label class="title is-5">Description:</label>
    <p></p>
    <p class="subtitle has-text-grey-3"> {{poi.description}}</p>
  </div>
</section>
{{/if}}

{{#if comments}}
{{> comment-section}}
{{/if }}
<section class="section">
{{#if poi.images}}
{{> gallery}}
{{else}}
<div class="box">
{{> add-image}}
 <h1 class="title-5 mt-2">Currently no image in the gallery</h1>
</div>
{{/if}}
</section>




{{> edit-poi}}

<script>var map = L.map('map').setView([{{ poi.latitude }}, {{ poi.longitude }}], 10);
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
  }).addTo(map);
  var marker = L.marker([{{ poi.latitude }}, {{ poi.longitude }}])
  .addTo(map)
    .bindPopup("\
  <p>{{poi.category}}</p>\
  <p>{{poi.name}}</p>\
  <p>{{poi.summary}}</p>")
    .openPopup()
</script>